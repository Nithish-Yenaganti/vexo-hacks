# Wrist Agent settings. Copy this file to .env and fill in the values:
#     cp .env.example .env
# .env is in .gitignore: never commit it, never paste keys into a chat.

# ---- Keys ---------------------------------------------------------------------------

# Speech to text (Deepgram). Needed for a real band.
DEEPGRAM_API_KEY=

# Voice for the replies. OpenAI is used first when both are set.
# With neither, the Mac's built-in voice is used.
OPENAI_API_KEY=
ELEVENLABS_API_KEY=

# ---- Models (leave empty for the default) ----------------------------------------------

# Deepgram speech-to-text model.
#   nova-3 (default, best, live)   nova-2 (older, cheaper)
DEEPGRAM_MODEL=nova-3

# OpenAI text-to-speech model.
#   gpt-4o-mini-tts (default, natural, tone can be steered)   tts-1 (fastest)   tts-1-hd (higher quality)
OPENAI_TTS_MODEL=gpt-4o-mini-tts

# OpenAI voice.
#   alloy (default) ash ballad coral echo fable nova onyx sage shimmer verse
#   marin cedar (newer models only)
OPENAI_TTS_VOICE=coral

# ElevenLabs voice ID (from your ElevenLabs voice library). Empty = Rachel.
ELEVENLABS_VOICE_ID=

# Computer use (the "Computer use" agent): OpenAI model and tool type.
# Leave empty for gpt-5.5 / computer. (Older: computer-use-preview / computer_use_preview.)
OPENAI_COMPUTER_MODEL=
OPENAI_COMPUTER_TOOL=
